# Copy to .env and fill in.

# From @BotFather
BOT_TOKEN=

# SQLite database file (created automatically). On the server: /var/lib/hifzbuddy/HifzBuddyBot.db
DB_PATH=./data/HifzBuddyBot.db

NODE_ENV=production

# Optional: your own Telegram user ID. The daily backup is sent to this chat.
# Find it by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=

# Optional backup settings
# BACKUP_DIR=          (default: a "backups" folder next to the database)
# BACKUP_KEEP=14
